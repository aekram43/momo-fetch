{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MOMO WORK",
  "version": "1.0.0",
  "identifier": "com.createder.momo-worker",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && cargo build --release --bin momo-fetch && cp target/release/momo-fetch desktop/src-tauri/binaries/'"
  },
  "app": {
    "windows": [
      {
        "title": "MOMO WORK",
        "width": 1440,
        "height": 900,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/"
    ],
    "shortDescription": "Supervise a momo-fetch agent",
    "longDescription": "Chat, tool approvals, memory vault and sandboxed file access for the momo-fetch agent harness.",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "momo"
        ]
      }
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/aekram43/momo-fetch/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
