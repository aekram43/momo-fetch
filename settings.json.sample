{
  "//===================================================":
    "====================================================",
  "// MOMO Fetch - Settings Configuration",
  "//===================================================":
    "====================================================",
  "//",
  "// Settings file priority (highest to lowest):",
  "// 1. CLI flags (--provider, --model, --permission)",
  "// 2. Project-level: .harness/settings.json",
  "// 3. Global: ~/.config/momo-fetch/settings.json",
  "// 4. Default values (lowest)",
  "//",
  "// Copy this file to .harness/settings.json and customize",
  "//===================================================":
    "====================================================",


  "// ┌─────────────────────────────────────────────────────────┐",
  "// │  PERMISSION MODE                                          │",
  "// └─────────────────────────────────────────────────────────┘",
  "// Controls command execution permission prompts:",
  "// - \"strict\":  Always ask before running commands (default)",
  "// - \"auto\":   Auto-allow read-only commands, ask for writes",
  "// - \"yolo\":   Auto-allow all commands (use with caution!)",

  "permission_mode": "auto",


  "// ┌─────────────────────────────────────────────────────────┐",
  "// │  DEFAULT LLM PROVIDER                                     │",
  "// └─────────────────────────────────────────────────────────┘",
  "//",
  "// Available providers:",
  "// - \"anthropic\":  Claude (Claude Sonnet 4, etc.)",
  "// - \"openai\":     OpenAI GPT models",
  "// - \"deepseek\":   DeepSeek models",
  "// - \"groq\":       Groq-hosted models",
  "// - \"openrouter\": OpenRouter (multi-provider aggregator)",
  "// - \"ollama\":     Local Ollama (no API key needed)",
  "// - \"zai\":        ZAI API (requires valid ZAI_API_KEY)",
  "// - \"custom\":     Generic OpenAI-compatible API (set LLM_URL, LLM_APIKEY, LLM_MODEL in .env)",
  "//",
  "// For memory sidecar model (Option B), use a cheaper/faster provider:",
  "// Recommended: \"deepseek\", \"groq\", or \"ollama\" for local",

  "default_provider": "anthropic",


  "// ┌─────────────────────────────────────────────────────────┐",
  "// │  DEFAULT MODEL                                            │",
  "// └─────────────────────────────────────────────────────────┘",
  "//",
  "// Model recommendations by provider:",
  "//",
  "// anthropic:",
  "//   - \"claude-sonnet-4-20250514\"   (recommended, 200K context)",
  "//   - \"claude-sonnet-4-20250514\"   (fast)",
  "//   - \"claude-opus-4-20250514\"     (premium)",
  "//",
  "// openai:",
  "//   - \"gpt-4o\"                     (recommended)",
  "//   - \"gpt-4o-mini\"                (fast, cheap)",
  "//   - \"gpt-4-turbo\"                (legacy)",
  "//",
  "// deepseek:",
  "//   - \"deepseek-chat\"              (recommended)",
  "//   - \"deepseek-reasoner\"          (reasoning-focused)",
  "//",
  "// groq:",
  "//   - \"llama-3.3-70b-versatile\"    (recommended)",
  "//   - \"mixtral-8x7b-32768\"         (fast)",
  "//",
  "// openrouter:",
  "//   - \"anthropic/claude-sonnet-4\"  (format: provider/model)",
  "//   - \"openai/gpt-4o\"",
  "//   - \"google/gemini-pro-1.5\"",
  "//",
  "// ollama (local):",
  "//   - \"llama3.2\"                   (default)",
  "//   - \"mistral\"                    (alternative)",
  "//   - \"codellama\"                  (code-focused)",
  "//",
  "// zai:",
  "//   - \"GLM-4.7\"                    (current)",
  "//   - \"GLM-5\"                      (latest)",
  "//",
  "// generic OpenAI-compatible (custom):",
  "//   - Any model name supported by your provider",

  "default_model": "claude-sonnet-4-20250514",


  "// ┌─────────────────────────────────────────────────────────┐",
  "// │  MEMORY AUTO-FLOW SETTINGS                               │",
  "// └─────────────────────────────────────────────────────────┘",
  "//",
  "// Controls automatic memory retrieval and storage during",
  "// conversations. Memory is stored in memory-vault/ as MemCells.",

  "memory": {
    "// Auto-search memory vault before each turn:",
    "// - true:  Automatically inject relevant memories ($0 cost)",
    "// - false: Only search when explicitly requested",
    "// Uses grep-based search (fast, no LLM calls)",

    "auto_search": true,


    "// Auto-write MemCells after each turn:",
    "// - true:  Automatically save conversations to memory",
    "// - false: Only save when explicitly requested",

    "auto_write": true,


    "// Retrieval mode for auto-search:",
    "// - \"grep_llm\":    Grep search + LLM reranking (recommended)",
    "// - \"tag_filter\":  Tag-based filtering only (faster)",

    "search_mode": "grep_llm",


    "// Max memory results to inject per turn:",
    "// Recommended: 3-10. Higher = more context but more tokens.",

    "max_results_per_turn": 5,


    "// MemCell threshold to trigger auto-extract:",
    "// After this many turns in a conversation, automatically extract:",
    "// - Events (what happened)",
    "// - Foresights (what was planned)",
    "// Set to 0 to disable auto-extract.",
    "// Recommended: 10-20 turns.",

    "extract_threshold": 10,


    "// ┌───────────────────────────────────────────────────────┐",
    "// │  MEMORY SIDECAR (Option B)                             │",
    "// └───────────────────────────────────────────────────────┘",
    "//",
    "// Advanced: Use a separate LLM for memory extraction.",
    "//",
    "// Option A (default, null):",
    "//   - No sidecar LLM",
    "//   - Uses TF-IDF keywords for memory extraction",
    "//   - $0 extra cost",
    "//",
    "// Option B (set sidecar_model + sidecar_provider):",
    "//   - Spawns a sub-agent with specified model",
    "//   - Higher quality memory extraction",
    "//   - Adds LLM API costs per turn",
    "//",
    "// Recommended for Option B:",
    "// - deepseek-chat (cheap, good quality)",
    "// - groq/llama-3.3-70b-versatile (fast, free tier available)",
    "// - ollama (local, free)",
    "//",
    "// ⚠️ WARNING: If using \"zai\", ensure ZAI_API_KEY is valid!",
    "// - Update .env: ZAI_API_KEY=your_valid_key",
    "// - Or switch to another provider to avoid 401 errors",
    "//",
    "// For best cost/performance, avoid premium models like",
    "// Claude Sonnet/Opus for sidecar - use cheaper alternatives.",

    "sidecar_model": null,
    "sidecar_provider": "deepseek",


    "// MemCell threshold to trigger auto-consolidate:",
    "// After this many MemCells, automatically run consolidation:",
    "// - Cluster related memories",
    "// - Update user profile",
    "// - Clean up redundant entries",
    "// Set to 0 to disable auto-consolidate.",
    "// Recommended: 30-50 MemCells.",

    "consolidate_threshold": 30
  },


  "// ┌─────────────────────────────────────────────────────────┐",
  "// │  CONTEXT WINDOW OVERRIDES                                 │",
  "// └─────────────────────────────────────────────────────────┘",
  "//",
  "// Override context window sizes for specific models.",
  "// Useful if the auto-detected size is incorrect.",
  "//",
  "// Format:",
  "//   \"model_name\": token_count",
  "//",
  "// Examples:",
  "//   {",
  "//     \"claude-sonnet-4-20250514\": 200000,",
  "//     \"openai:gpt-4o\": 128000,",
  "//     \"local-model\": 32768",
  "//   }",
  "//",
  "// Use \"provider:model\" format to disambiguate if needed.",
  "// Most users don't need to set this - auto-detection works well.",

  "context_window": {
    "// Uncomment and modify if auto-detection fails:",
    "// "claude-sonnet-4-20250514": 200000,
    "// "gpt-4o": 128000,
    "// "deepseek-chat": 64000
  },


  "// ┌─────────────────────────────────────────────────────────┐",
  "// │  EXAMPLE CONFIGURATIONS                                   │",
  "// └─────────────────────────────────────────────────────────┘",
  "//",
  "// Quick setups for different use cases:",
  "//",
  "// ───────────────────────────────────────────────────────────",
  "// 🚀 CHEAP & FAST (Recommended for development)",
  "// ───────────────────────────────────────────────────────────",
  "// {",
  "//   \"permission_mode\": \"auto\",",
  "//   \"default_provider\": \"deepseek\",",
  "//   \"default_model\": \"deepseek-chat\",",
  "//   \"memory\": {",
  "//     \"auto_search\": true,",
  "//     \"auto_write\": true,",
  "//     \"sidecar_provider\": \"groq\",",
  "//     \"sidecar_model\": \"llama-3.3-70b-versatile\"",
  "//   }",
  "// }",
  "//",
  "// ───────────────────────────────────────────────────────────",
  "// 💎 PREMIUM QUALITY (Best for production)",
  "// ───────────────────────────────────────────────────────────",
  "// {",
  "//   \"permission_mode\": \"auto\",",
  "//   \"default_provider\": \"anthropic\",",
  "//   \"default_model\": \"claude-sonnet-4-20250514\",",
  "//   \"memory\": {",
  "//     \"auto_search\": true,",
  "//     \"auto_write\": true,",
  "//     \"sidecar_provider\": \"deepseek\",",
  "//     \"sidecar_model\": \"deepseek-chat\"",
  "//   }",
  "// }",
  "//",
  "// ───────────────────────────────────────────────────────────",
  "// 🏠 LOCAL ONLY (No API keys needed)",
  "// ───────────────────────────────────────────────────────────",
  "// {",
  "//   \"permission_mode\": \"yolo\",",
  "//   \"default_provider\": \"ollama\",",
  "//   \"default_model\": \"llama3.2\",",
  "//   \"memory\": {",
  "//     \"auto_search\": true,",
  "//     \"auto_write\": true,",
  "//     \"sidecar_provider\": \"ollama\",",
  "//     \"sidecar_model\": \"llama3.2\"",
  "//   }",
  "// }",
  "//",
  "// ───────────────────────────────────────────────────────────",
  "// 🌐 MULTI-PROVIDER (OpenRouter for main, cheap for sidecar)",
  "// ───────────────────────────────────────────────────────────",
  "// {",
  "//   \"permission_mode\": \"auto\",",
  "//   \"default_provider\": \"openrouter\",",
  "//   \"default_model\": \"anthropic/claude-sonnet-4\",",
  "//   \"memory\": {",
  "//     \"auto_search\": true,",
  "//     \"auto_write\": true,",
  "//     \"sidecar_provider\": \"groq\",",
  "//     \"sidecar_model\": \"llama-3.3-70b-versatile\"",
  "//   }",
  "// }",
  "//",
  "// ───────────────────────────────────────────────────────────",
  "// 🔧 FIX FOR ZAI 401 ERROR",
  "// ───────────────────────────────────────────────────────────",
  "// If you get \"zai API error (HTTP 401 Unauthorized):",
  "//",
  "// Option 1: Update ZAI API key in .env",
  "//   ZAI_API_KEY=your_new_valid_key",
  "//",
  "// Option 2: Switch to a different provider",
  "//   {",
  "//     \"memory\": {",
  "//       \"sidecar_provider\": \"deepseek\",",
  "//       \"sidecar_model\": \"deepseek-chat\"",
  "//     }",
  "//   }",
  "//",
  "// Option 3: Disable sidecar (use Option A - TF-IDF)",
  "//   {",
  "//     \"memory\": {",
  "//       \"sidecar_model\": null,",
  "//       \"sidecar_provider\": null",
  "//     }",
  "//   }",
  "//",
  "// ───────────────────────────────────────────────────────────",
  "// 🔧 GENERIC OPENAI-COMPATIBLE PROVIDER",
  "// ───────────────────────────────────────────────────────────",
  "// For any OpenAI-compatible API (vLLM, Together AI, etc.):",
  "//",
  "// In .env:",
  "//   LLM_URL=https://api.provider.com/v1",
  "//   LLM_API_KEY=your_api_key",
  "//   LLM_MODEL=model_name",
  "//",
  "// In settings.json:",
  "//   {",
  "//     \"default_provider\": \"custom\",",
  "//     \"default_model\": \"model_name\"",
  "//   }",
  "//",
  "//===============================================================",
  "// END OF SETTINGS",
  "//==============================================================="
}